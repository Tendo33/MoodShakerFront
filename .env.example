# Chat model (any OpenAI-compatible endpoint). Compare models with `pnpm eval:recipes`.
# Measured on SiliconFlow (8-order eval): DeepSeek-V3.2 ~65-85 s a drink, rarely
# needs a repair turn; Pro/moonshotai/Kimi-K2.6 ~30-65 s, livelier writing, more
# repairs; Qwen/Qwen3.6-35B-A3B ~15 s, more mistakes in classic specs.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.siliconflow.cn/v1"
OPENAI_MODEL="deepseek-ai/DeepSeek-V3.2"
# Set to true only once the endpoint is confirmed to enforce response_format json_schema.
OPENAI_SUPPORTS_JSON_SCHEMA=false
# Sends enable_thinking=false; needed for hybrid models such as Qwen3 on SiliconFlow.
OPENAI_DISABLE_THINKING=false

# Image model
IMAGE_API_URL="https://api.siliconflow.cn/v1/images/generations"
IMAGE_API_KEY=""
IMAGE_MODEL="Qwen/Qwen-Image"
# Extra hosts the image provider may return results from (comma-separated).
IMAGE_FETCH_HOST_ALLOWLIST=""

# Cloudflare R2 (where generated images are stored)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="moodshaker-images"
R2_PUBLIC_BASE_URL="https://img.moodshaker.de"

# Canonical site URL for metadata, sitemap and JSON-LD
SITE_URL="https://moodshaker.de"

# Reverse proxies in front of the app: 0 when exposed directly, 1 behind Caddy/Nginx.
# Used to read the real client IP from x-forwarded-for for rate limiting.
TRUSTED_PROXY_HOPS=0

# PostgreSQL (rate limits live here too, so it is required in every environment)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodshaker"

# docker compose
HOST_PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moodshaker
