# OpenAI API Configuration
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.siliconflow.cn/v1/"
OPENAI_MODEL="deepseek-v3"

# Image Generation API Configuration
IMAGE_API_URL="https://api.siliconflow.cn/v1/images/generations"
IMAGE_API_KEY=""
IMAGE_MODEL="Qwen/Qwen-Image"


# Cloudflare R2 Object Storage (生成图片的存放位置)
# Access Key ID 是 R2 API token 的 id；Secret 是 token value 的 SHA-256。
# 在 Dashboard 的 R2 > Manage R2 API Tokens 创建，权限选 Object Read & Write。
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="moodshaker-images"
R2_PUBLIC_BASE_URL="https://img.moodshaker.de"

# 反向代理层数。直连填 0；Caddy/Nginx 反代后填 1。
# 用于从 x-forwarded-for 右侧数出可信的客户端 IP，防止伪造首跳绕过限流。
TRUSTED_PROXY_HOPS=0

# Database Configuration
# 本地开发时连接 localhost，Docker 内部连接 db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodshaker?schema=public"

# Docker Compose Database Variables
HOST_PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moodshaker
