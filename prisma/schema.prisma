generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecommendationStatus {
  PRIVATE
  PUBLISHED
}

/// A published cocktail.
///
/// Was 26 columns, 8 of them `xxx` / `english_xxx` pairs. Every read site had to
/// pick between a pair by hand, and adding a third language would have meant
/// eight more columns. Free text now lives in `content` as
/// `{ name: { cn, en }, ... }`, and the three closed vocabularies are stored as
/// codes so no boundary has to match display text.
model Cocktail {
  id     String @id @default(uuid())
  /// Stable URL identifier. Replaces the unique constraint that was on `name`:
  /// two drinks may legitimately share a name, and the real requirement was a
  /// unique URL.
  slug   String @unique
  /// Locale-keyed recipe content: name, description, matchReason, servingGlass,
  /// timeRequired, ingredients, tools, steps. Mirrors the shape already used by
  /// `RecommendationSession.cocktailPayload`.
  content Json

  /// Vocabulary codes from `lib/domain/vocabulary.ts`, not display text.
  /// Kept as columns rather than folded into `content` so they stay indexable.
  baseSpirit     String   @map("base_spirit")
  alcoholLevel   String   @map("alcohol_level")
  flavorProfiles String[] @map("flavor_profiles")

  imageUrl     String? @map("image_url") @db.Text
  thumbnailUrl String? @map("thumbnail_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recommendations RecommendationSession[]

  @@index([baseSpirit], name: "idx_cocktail_base_spirit")
  @@index([alcoholLevel], name: "idx_cocktail_alcohol_level")
  /// Composite and descending to match the gallery's keyset pagination, which
  /// orders by `(created_at, id)` descending. A single-column index on createdAt
  /// leaves the tiebreaker unindexed.
  @@index([createdAt(sort: Desc), id(sort: Desc)], name: "idx_cocktail_created_at")
  @@map("cocktails")
}

model RecommendationSession {
  id                String               @id @default(cuid())
  sessionId         String               @map("session_id")
  editToken         String               @unique @map("edit_token")
  language          String
  agentType         String               @map("agent_type")
  answers           Json
  baseSpirits       String[]             @map("base_spirits")
  specialRequests   String?              @map("special_requests")
  cocktailPayload   Json                 @map("cocktail_payload")
  // Legacy inline image storage. Superseded by imageUrl/thumbnailUrl; retained
  // during the dual-read window and dropped once the backfill is verified.
  image             String?              @db.Text
  thumbnail         String?              @db.Text
  imageUrl          String?              @map("image_url") @db.Text
  thumbnailUrl      String?              @map("thumbnail_url") @db.Text
  status            RecommendationStatus @default(PRIVATE)
  publishedCocktailId String?            @map("published_cocktail_id")
  publishedCocktail Cocktail?            @relation(fields: [publishedCocktailId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([sessionId], name: "idx_recommendation_session_session_id")
  @@index([status, createdAt], name: "idx_recommendation_session_status_created_at")
  @@map("recommendation_sessions")
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt], name: "idx_rate_limit_bucket_reset_at")
  @@map("rate_limit_buckets")
}
