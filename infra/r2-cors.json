{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://moodshaker.de",
          "https://www.moodshaker.de",
          "http://localhost:3000"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
