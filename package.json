{
  "name": "moodshaker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:init": "pnpm db:migrate && pnpm db:seed",
    "eval:recipes": "node --conditions=react-server --env-file=.env --env-file=.env.local --import tsx scripts/eval-recipes.ts",
    "seeds:build": "node --conditions=react-server --env-file=.env --env-file=.env.local --import tsx scripts/build-seeds.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.20.6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=1.0 <1.1.16": "^1.1.16",
      "browserslist@>=4.0 <4.28.7": "^4.28.7",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "minimatch@<11.0.1": "^11.0.1"
    }
  }
}
